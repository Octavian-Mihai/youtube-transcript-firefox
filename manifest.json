{
  "manifest_version": 3,
  "name": "YouTube Transcript Copier",
  "version": "1.0.0",
  "description": "Copy the current YouTube video’s captions to the clipboard as timestamped text.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{babe36f9-a750-4be0-a851-5bd76d29df69}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["activeTab", "clipboardWrite", "scripting"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtube.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Copy YouTube transcript",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": ["content/main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": ["content/isolated.js"],
      "run_at": "document_idle"
    }
  ]
}
